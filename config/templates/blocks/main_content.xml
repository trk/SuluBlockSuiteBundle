<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>main_content</key>
    <meta>
        <title lang="en">Page Content Slot</title>
        <title lang="tr">Sayfa İçeriği Yuvası</title>
        <title lang="de">Seiteninhaltsbereich</title>
        <title lang="ru">Область контента страницы</title>
        <title lang="es">Espacio de Contenido de Página</title>
        <title lang="fr">Emplacement de Contenu de Page</title>
    </meta>
    <properties>
        <property name="slot_info" type="text_line">
            <meta>
                <title lang="en">Slot Label / Note</title>
                <title lang="tr">Yuva Etiketi / Notu</title>
                <title lang="de">Bereichsbezeichnung / Notiz</title>
                <title lang="ru">Метка области / Заметка</title>
                <title lang="es">Etiqueta del Espacio / Nota</title>
                <title lang="fr">Étiquette de l'Emplacement / Note</title>
                <info_text lang="en">The page's own content blocks will be rendered at this exact location within the layout.</info_text>
                <info_text lang="tr">Sayfanın kendi içerik blokları, bu düzen içerisinde tam bu konuma yerleştirilip render edilir.</info_text>
                <info_text lang="de">Die Inhaltsblöcke der Seite werden an dieser genauen Stelle im Layout gerendert.</info_text>
                <info_text lang="ru">Собственные блоки контента страницы будут отображаться именно в этом месте макета.</info_text>
                <info_text lang="es">Los bloques de contenido de la página se renderizarán exactamente en esta ubicación del diseño.</info_text>
                <info_text lang="fr">Les blocs de contenu de la page seront affichés à cet emplacement précis de la mise en page.</info_text>
            </meta>
        </property>

        <property name="container_width" type="single_select" colspan="6">
            <meta>
                <title lang="en">Container Width</title>
                <title lang="tr">Kapsayıcı Genişliği</title>
                <title lang="de">Container-Breite</title>
                <title lang="ru">Ширина контейнера</title>
                <title lang="es">Ancho del Contenedor</title>
                <title lang="fr">Largeur du Conteneur</title>
            </meta>
            <params>
                <param name="default_value" value="default"/>
                <param name="values" type="collection">
                    <param name="default">
                        <meta>
                            <title lang="en">Standard (85rem / 7xl)</title>
                            <title lang="tr">Standart (85rem / 7xl)</title>
                            <title lang="de">Standard (85rem / 7xl)</title>
                            <title lang="ru">Стандартный (85rem / 7xl)</title>
                            <title lang="es">Estándar (85rem / 7xl)</title>
                            <title lang="fr">Standard (85rem / 7xl)</title>
                        </meta>
                    </param>
                    <param name="full">
                        <meta>
                            <title lang="en">Full Width (100%)</title>
                            <title lang="tr">Tam Genişlik (%100)</title>
                            <title lang="de">Volle Breite (100%)</title>
                            <title lang="ru">Полная ширина (100%)</title>
                            <title lang="es">Ancho Completo (100%)</title>
                            <title lang="fr">Pleine Largeur (100%)</title>
                        </meta>
                    </param>
                    <param name="narrow">
                        <meta>
                            <title lang="en">Narrow / Prose (48rem / 3xl)</title>
                            <title lang="tr">Dar / Makale (48rem / 3xl)</title>
                            <title lang="de">Schmal / Fließtext (48rem / 3xl)</title>
                            <title lang="ru">Узкий / Текст (48rem / 3xl)</title>
                            <title lang="es">Estrecho / Artículo (48rem / 3xl)</title>
                            <title lang="fr">Étroit / Article (48rem / 3xl)</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <property name="padding_y" type="single_select" colspan="6">
            <meta>
                <title lang="en">Vertical Spacing</title>
                <title lang="tr">Dikey Boşluk</title>
                <title lang="de">Vertikaler Abstand</title>
                <title lang="ru">Вертикальный отступ</title>
                <title lang="es">Espaciado Vertical</title>
                <title lang="fr">Espacement Vertical</title>
            </meta>
            <params>
                <param name="default_value" value="default"/>
                <param name="values" type="collection">
                    <param name="none">
                        <meta>
                            <title lang="en">None (0)</title>
                            <title lang="tr">Yok (0)</title>
                            <title lang="de">Keiner (0)</title>
                            <title lang="ru">Нет (0)</title>
                            <title lang="es">Ninguno (0)</title>
                            <title lang="fr">Aucun (0)</title>
                        </meta>
                    </param>
                    <param name="sm">
                        <meta>
                            <title lang="en">Small (py-4)</title>
                            <title lang="tr">Küçük (py-4)</title>
                            <title lang="de">Klein (py-4)</title>
                            <title lang="ru">Маленький (py-4)</title>
                            <title lang="es">Pequeño (py-4)</title>
                            <title lang="fr">Petit (py-4)</title>
                        </meta>
                    </param>
                    <param name="default">
                        <meta>
                            <title lang="en">Medium (py-8)</title>
                            <title lang="tr">Orta (py-8)</title>
                            <title lang="de">Mittel (py-8)</title>
                            <title lang="ru">Средний (py-8)</title>
                            <title lang="es">Medio (py-8)</title>
                            <title lang="fr">Moyen (py-8)</title>
                        </meta>
                    </param>
                    <param name="lg">
                        <meta>
                            <title lang="en">Large (py-16)</title>
                            <title lang="tr">Geniş (py-16)</title>
                            <title lang="de">Groß (py-16)</title>
                            <title lang="ru">Большой (py-16)</title>
                            <title lang="es">Grande (py-16)</title>
                            <title lang="fr">Grand (py-16)</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <property name="props" type="block_props" colspan="12">
            <params>
                <param name="component_type" value="main_content"/>
            </params>
        </property>
    </properties>
</template>
