<?xml version="1.0" ?>
<template xmlns="http://schemas.sulu.io/template/template"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/template-1.0.xsd">
    <key>page_header</key>
    <meta>
        <title lang="en">Page Header / Hero</title>
        <title lang="tr">Sayfa Başlığı ve Tanıtımı</title>
        <title lang="de">Seitenkopfbereich / Hero</title>
        <title lang="ru">Заголовок страницы / Hero</title>
        <title lang="es">Encabezado de Página / Hero</title>
        <title lang="fr">En-tête de Page / Hero</title>
    </meta>
    <properties>
        <property name="header_layout" type="single_select" colspan="6">
            <meta>
                <title lang="en">Layout Style</title>
                <title lang="tr">Düzen Stili</title>
                <title lang="de">Layoutstil</title>
                <title lang="ru">Стиль макета</title>
                <title lang="es">Estilo de Diseño</title>
                <title lang="fr">Style de Disposition</title>
            </meta>
            <params>
                <param name="default_value" value="standard"/>
                <param name="values" type="collection">
                    <param name="standard">
                        <meta>
                            <title lang="en">Standard (Stacked)</title>
                            <title lang="tr">Standart (Dikey Sıralı)</title>
                            <title lang="de">Standard (Gestapelt)</title>
                            <title lang="ru">Стандартный (Вертикальный)</title>
                            <title lang="es">Estándar (Apilado)</title>
                            <title lang="fr">Standard (Empilé)</title>
                        </meta>
                    </param>
                    <param name="split">
                        <meta>
                            <title lang="en">Split (2 Columns Hero)</title>
                            <title lang="tr">İki Sütunlu (Yan Yana Hero)</title>
                            <title lang="de">Geteilt (2 Spalten Hero)</title>
                            <title lang="ru">Разделённый (2 колонки)</title>
                            <title lang="es">Dividido (2 Columnas Hero)</title>
                            <title lang="fr">Divisé (2 Colonnes Hero)</title>
                        </meta>
                    </param>
                    <param name="minimal">
                        <meta>
                            <title lang="en">Minimal (Title &amp; Meta Only)</title>
                            <title lang="tr">Minimal (Yalnızca Başlık &amp; Meta)</title>
                            <title lang="de">Minimal (Nur Titel &amp; Meta)</title>
                            <title lang="ru">Минималистичный (Только заголовок)</title>
                            <title lang="es">Mínimo (Solo Título y Meta)</title>
                            <title lang="fr">Minimal (Titre et Méta)</title>
                        </meta>
                    </param>
                </param>
            </params>
        </property>

        <property name="show_breadcrumbs" type="checkbox" colspan="6">
            <meta>
                <title lang="en">Show Breadcrumbs</title>
                <title lang="tr">Sayfa Yolunu (Breadcrumb) Göster</title>
                <title lang="de">Brotkrümelnavigation anzeigen</title>
                <title lang="ru">Показывать навигационную цепочку</title>
                <title lang="es">Mostrar Migas de Pan</title>
                <title lang="fr">Afficher le Fil d'Ariane</title>
            </meta>
            <params>
                <param name="default_value" value="true"/>
            </params>
        </property>

        <property name="override_title" type="text_line" colspan="6">
            <meta>
                <title lang="en">Custom Title (Optional)</title>
                <title lang="tr">Özel Başlık (İsteğe Bağlı)</title>
                <title lang="de">Benutzerdefinierter Titel (Optional)</title>
                <title lang="ru">Свой заголовок (Необязательно)</title>
                <title lang="es">Título Personalizado (Opcional)</title>
                <title lang="fr">Titre Personnalisé (Optionnel)</title>
                <info_text lang="en">Leave empty to use current page title</info_text>
                <info_text lang="tr">Mevcut sayfa başlığını kullanmak için boş bırakın</info_text>
                <info_text lang="de">Leer lassen, um den aktuellen Seitentitel zu verwenden</info_text>
                <info_text lang="ru">Оставьте пустым для использования заголовка страницы</info_text>
                <info_text lang="es">Dejar vacío para usar el título de la página actual</info_text>
                <info_text lang="fr">Laissez vide pour utiliser le titre de la page actuelle</info_text>
            </meta>
        </property>

        <property name="override_headline" type="text_line" colspan="6">
            <meta>
                <title lang="en">Custom Headline (Optional)</title>
                <title lang="tr">Özel Başlık / Manşet (İsteğe Bağlı)</title>
                <title lang="de">Benutzerdefinierter Anzeigetitel (Optional)</title>
                <title lang="ru">Свой заголовок / Маншет (Необязательно)</title>
                <title lang="es">Titular Personalizado (Opcional)</title>
                <title lang="fr">Titre Personnalisé (Optionnel)</title>
                <info_text lang="en">Leave empty to use current page headline</info_text>
                <info_text lang="tr">Mevcut sayfa manşetini kullanmak için boş bırakın</info_text>
                <info_text lang="de">Leer lassen, um die aktuelle Seitenschlagzeile zu verwenden</info_text>
                <info_text lang="ru">Оставьте пустым для использования заголовка страницы</info_text>
                <info_text lang="es">Dejar vacío para usar el titular de la página actual</info_text>
                <info_text lang="fr">Laissez vide pour utiliser le titre de la page actuelle</info_text>
            </meta>
        </property>

        <property name="override_summary" type="text_area" colspan="12">
            <meta>
                <title lang="en">Custom Summary / Teaser (Optional)</title>
                <title lang="tr">Özel Özet / Spot (İsteğe Bağlı)</title>
                <title lang="de">Benutzerdefinierte Zusammenfassung (Optional)</title>
                <title lang="ru">Своё краткое описание (Необязательно)</title>
                <title lang="es">Resumen Personalizado (Opcional)</title>
                <title lang="fr">Résumé Personnalisé (Optionnel)</title>
                <info_text lang="en">Leave empty to use current page summary</info_text>
                <info_text lang="tr">Mevcut sayfa özetini kullanmak için boş bırakın</info_text>
                <info_text lang="de">Leer lassen, um den aktuellen Seitenteaser zu verwenden</info_text>
                <info_text lang="ru">Оставьте пустым для использования описания страницы</info_text>
                <info_text lang="es">Dejar vacío para usar el resumen de la página actual</info_text>
                <info_text lang="fr">Laissez vide pour utiliser le résumé de la page actuelle</info_text>
            </meta>
        </property>

        <property name="override_meta" type="text_line" colspan="12">
            <meta>
                <title lang="en">Custom Meta Tag / Eyebrow (Optional)</title>
                <title lang="tr">Özel Meta Etiket / Rozet (İsteğe Bağlı)</title>
                <title lang="de">Benutzerdefiniertes Meta-Tag (Optional)</title>
                <title lang="ru">Свой мета-тег (Необязательно)</title>
                <title lang="es">Etiqueta Meta Personalizada (Opcional)</title>
                <title lang="fr">Balise Méta Personnalisée (Optionnel)</title>
                <info_text lang="en">Optional badge/eyebrow above or below the title</info_text>
                <info_text lang="tr">Başlığın üstünde veya altında isteğe bağlı rozet/etiket</info_text>
                <info_text lang="de">Optionales Badge über oder unter dem Titel</info_text>
                <info_text lang="ru">Необязательный бейдж над или под заголовком</info_text>
                <info_text lang="es">Insignia opcional encima o debajo del título</info_text>
                <info_text lang="fr">Badge optionnel au-dessus ou au-dessous du titre</info_text>
            </meta>
        </property>

        <property name="override_content" type="text_editor" colspan="12">
            <meta>
                <title lang="en">Custom Content (Optional)</title>
                <title lang="tr">Özel Açıklama / İçerik (İsteğe Bağlı)</title>
                <title lang="de">Benutzerdefinierter Inhalt (Optional)</title>
                <title lang="ru">Свой контент (Необязательно)</title>
                <title lang="es">Contenido Personalizado (Opcional)</title>
                <title lang="fr">Contenu Personnalisé (Optionnel)</title>
                <info_text lang="en">Leave empty to use current page summary content</info_text>
                <info_text lang="tr">Mevcut sayfa özetini kullanmak için boş bırakın</info_text>
                <info_text lang="de">Leer lassen, um den aktuellen Seiteninhalt zu verwenden</info_text>
                <info_text lang="ru">Оставьте пустым для использования содержания страницы</info_text>
                <info_text lang="es">Dejar vacío para usar el contenido de la página actual</info_text>
                <info_text lang="fr">Laissez vide pour utiliser le contenu de la page actuelle</info_text>
            </meta>
        </property>

        <property name="props" type="block_props" colspan="12">
            <params>
                <param name="component_type" value="page_header"/>
            </params>
        </property>
    </properties>
</template>
