                <param name="4xl">
                    <meta>
                        <title lang="en">4X-Large (4xl)</title>
                        <title lang="tr">4X Büyük (4XL)</title>
                        <title lang="de">4X Groß (4XL)</title>
                        <title lang="ru">4X Большая (4XL)</title>
                        <title lang="es">4X Grande (4XL)</title>
                        <title lang="fr">4X Grand (4XL)</title>
                    </meta>
                </param>
                <param name="5xl">
                    <meta>
                        <title lang="en">5X-Large (5xl)</title>
                        <title lang="tr">5X Büyük (5XL)</title>
                        <title lang="de">5X Groß (5XL)</title>
                        <title lang="ru">5X Большая (5XL)</title>
                        <title lang="es">5X Grande (5XL)</title>
                        <title lang="fr">5X Grand (5XL)</title>
                    </meta>
                </param>
                <param name="7xl">
                    <meta>
                        <title lang="en">7X-Large (7xl)</title>
                        <title lang="tr">7X Büyük (7XL)</title>
                        <title lang="de">7X Groß (7XL)</title>
                        <title lang="ru">7X Большая (7XL)</title>
                        <title lang="es">7X Grande (7XL)</title>
                        <title lang="fr">7X Grand (7XL)</title>
                    </meta>
                </param>
                <param name="full">
                    <meta>
                        <title lang="en">Full</title>
                        <title lang="tr">Tam Genişlik</title>
                        <title lang="de">Voll</title>
                        <title lang="ru">Полная</title>
                        <title lang="es">Completo</title>
                        <title lang="fr">Pleine largeur</title>
                    </meta>
                </param>
            </param>
        </params>
    </property>

    <property name="max_width_breakpoint" type="single_select" colspan="6" mandatory="false" visibleCondition="max_width &amp;&amp; max_width != 'none'">
        <meta>
            <title lang="en">Max Width Breakpoint</title>
            <title lang="tr">Maksimum Genişlik Kırılım Noktası</title>
            <title lang="de">Max. Breite Breakpoint</title>
            <title lang="ru">Контрольная точка макс. ширины</title>
            <title lang="es">Punto de Ruptura de Ancho Máximo</title>
            <title lang="fr">Point de Rupture Largeur Max</title>
            <info_text lang="en">Define the device width from which the element's max-width will apply.</info_text>
            <info_text lang="tr">Öğenin maksimum genişliğinin uygulanacağı cihaz genişliğini tanımlayın.</info_text>
            <info_text lang="de">Definieren Sie die Gerätebreite, ab der die maximale Breite gilt.</info_text>
            <info_text lang="ru">Определите ширину экрана, начиная с которой применяется максимальная ширина.</info_text>
            <info_text lang="es">Defina el ancho del dispositivo a partir del cual se aplicará el ancho máximo.</info_text>
            <info_text lang="fr">Définissez la largeur d'écran à partir de laquelle la largeur maximale s'applique.</info_text>
        </meta>
        <params>
            <param name="default_value" value=""/>
            <param name="values" type="collection">
                <param name="">
                    <meta>
                        <title lang="en">Always</title>
                        <title lang="tr">Her Zaman</title>
                        <title lang="de">Immer</title>
                        <title lang="ru">Всегда</title>
                        <title lang="es">Siempre</title>
                        <title lang="fr">Toujours</title>
                    </meta>
                </param>
                <param name="sm">
                    <meta>
                        <title lang="en">Small (Phone Landscape)</title>
                        <title lang="tr">Küçük (Telefon Yatay - SM)</title>
                        <title lang="de">Klein (Telefon Querformat - SM)</title>
                        <title lang="ru">Малый (Телефон горизонтально - SM)</title>
                        <title lang="es">Pequeño (Teléfono Horizontal - SM)</title>
                        <title lang="fr">Petit (Téléphone Paysage - SM)</title>
                    </meta>
                </param>
                <param name="md">
                    <meta>
                        <title lang="en">Medium (Tablet Landscape)</title>
                        <title lang="tr">Orta (Tablet Yatay - MD)</title>
                        <title lang="de">Mittel (Tablet Querformat - MD)</title>
                        <title lang="ru">Средний (Планшет горизонтально - MD)</title>
                        <title lang="es">Mediano (Tablet Horizontal - MD)</title>
                        <title lang="fr">Moyen (Tablette Paysage - MD)</title>
                    </meta>
                </param>
                <param name="lg">
                    <meta>
                        <title lang="en">Large (Desktop)</title>
                        <title lang="tr">Büyük (Masaüstü - LG)</title>
                        <title lang="de">Groß (Desktop - LG)</title>
                        <title lang="ru">Большой (Десктоп - LG)</title>
                        <title lang="es">Grande (Escritorio - LG)</title>
                        <title lang="fr">Grand (Bureau - LG)</title>
                    </meta>
                </param>
                <param name="xl">
                    <meta>
                        <title lang="en">X-Large (Large Screens)</title>
                        <title lang="tr">Çok Büyük (Geniş Ekranlar - XL)</title>
                        <title lang="de">Extra Groß (Große Bildschirme - XL)</title>
                        <title lang="ru">Очень большой (Широкие экраны - XL)</title>
                        <title lang="es">Extra Grande (Pantallas Grandes - XL)</title>
                        <title lang="fr">Très Grand (Grands Écrans - XL)</title>
                    </meta>
                </param>
            </param>
        </params>
    </property>
    </properties>
</form>
