<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd">
    <key>block_suite_field_maxwidth</key>
    <properties>
    <property name="max_width" type="single_select" colspan="6" mandatory="false">
        <meta>
            <title lang="en">Max Width</title>
            <title lang="tr">Maksimum Genişlik</title>
            <title lang="de">Maximale Breite</title>
            <title lang="ru">Максимальная ширина</title>
            <title lang="es">Ancho Máximo</title>
            <title lang="fr">Largeur Maximale</title>
            <info_text lang="en">Set the maximum content width.</info_text>
            <info_text lang="tr">Maksimum içerik genişliğini ayarlayın.</info_text>
            <info_text lang="de">Legen Sie die maximale Inhaltsbreite fest.</info_text>
            <info_text lang="ru">Установите максимальную ширину контента.</info_text>
            <info_text lang="es">Establezca el ancho máximo del contenido.</info_text>
            <info_text lang="fr">Définissez la largeur maximale du contenu.</info_text>
        </meta>
        <params>
            <param name="default_value" value=""/>
            <param name="values" type="collection">
                <param name="">
                    <meta>
                        <title lang="en">None</title>
                        <title lang="tr">Yok (Sınırsız)</title>
                        <title lang="de">Keine</title>
                        <title lang="ru">Нет</title>
                        <title lang="es">Ninguno</title>
                        <title lang="fr">Aucun</title>
                    </meta>
                </param>
                <param name="sm">
                    <meta>
                        <title lang="en">Small (sm)</title>
                        <title lang="tr">Küçük (SM)</title>
                        <title lang="de">Klein (SM)</title>
                        <title lang="ru">Малая (SM)</title>
                        <title lang="es">Pequeño (SM)</title>
                        <title lang="fr">Petit (SM)</title>
                    </meta>
                </param>
                <param name="md">
                    <meta>
                        <title lang="en">Medium (md)</title>
                        <title lang="tr">Orta (MD)</title>
                        <title lang="de">Mittel (MD)</title>
                        <title lang="ru">Средняя (MD)</title>
                        <title lang="es">Mediano (MD)</title>
                        <title lang="fr">Moyen (MD)</title>
                    </meta>
                </param>
                <param name="lg">
                    <meta>
                        <title lang="en">Large (lg)</title>
                        <title lang="tr">Büyük (LG)</title>
                        <title lang="de">Groß (LG)</title>
                        <title lang="ru">Большая (LG)</title>
                        <title lang="es">Grande (LG)</title>
                        <title lang="fr">Grand (LG)</title>
                    </meta>
                </param>
                <param name="xl">
                    <meta>
                        <title lang="en">X-Large (xl)</title>
                        <title lang="tr">Çok Büyük (XL)</title>
                        <title lang="de">Extra Groß (XL)</title>
                        <title lang="ru">Очень большая (XL)</title>
                        <title lang="es">Extra Grande (XL)</title>
                        <title lang="fr">Très Grand (XL)</title>
                    </meta>
                </param>
                <param name="2xl">
                    <meta>
                        <title lang="en">2X-Large (2xl)</title>
                        <title lang="tr">Ekstra Büyük (2XL)</title>
                        <title lang="de">2X Groß (2XL)</title>
                        <title lang="ru">2X Большая (2XL)</title>
                        <title lang="es">2X Grande (2XL)</title>
                        <title lang="fr">2X Grand (2XL)</title>
                    </meta>
                </param>
                <param name="3xl">
                    <meta>
                        <title lang="en">3X-Large (3xl)</title>
                        <title lang="tr">3X Büyük (3XL)</title>
                        <title lang="de">3X Groß (3XL)</title>
                        <title lang="ru">3X Большая (3XL)</title>
