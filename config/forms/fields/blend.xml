<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd">
    <key>block_suite_field_blend</key>
    <properties>
    <property name="blend" type="checkbox" colspan="6" mandatory="false">
        <meta>
            <title lang="en">Blend</title>
            <title lang="tr">Karışım (Blend)</title>
            <title lang="de">Mischen (Blend)</title>
            <title lang="ru">Наложение (Blend)</title>
            <title lang="es">Fusión (Blend)</title>
            <title lang="fr">Fusion (Blend)</title>
            <info_text lang="en">Blend the element with the page content.</info_text>
            <info_text lang="tr">Öğeyi sayfa içeriğiyle harmanlayın (blend).</info_text>
            <info_text lang="de">Mischen Sie das Element mit dem Seiteninhalt.</info_text>
            <info_text lang="ru">Смешайте элемент с содержимым страницы.</info_text>
            <info_text lang="es">Fusione el elemento con el contenido de la página.</info_text>
            <info_text lang="fr">Fusionnez l'élément avec le contenu de la page.</info_text>
        </meta>
        <params>
            <param name="type" value="toggler"/>
            <param name="default_value" value="false"/>
            <param name="label">
                <meta>
                    <title lang="en">Blend with page content</title>
                    <title lang="tr">Sayfa içeriğiyle karıştır</title>
                    <title lang="de">Mit Seiteninhalt mischen</title>
                    <title lang="ru">Смешать с содержимым страницы</title>
                    <title lang="es">Fusionar con el contenido de la página</title>
                    <title lang="fr">Fusionner avec le contenu de la page</title>
                </meta>
            </param>
        </params>
    </property>
    </properties>
</form>
