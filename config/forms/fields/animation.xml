                <param name="medium">
                    <meta>
                        <title lang="en">Medium</title>
                        <title lang="tr">Orta</title>
                        <title lang="de">Mittel</title>
                        <title lang="ru">Средний</title>
                        <title lang="es">Medio</title>
                        <title lang="fr">Moyen</title>
                    </meta>
                </param>
                <param name="strong">
                    <meta>
                        <title lang="en">Strong</title>
                        <title lang="tr">Güçlü</title>
                        <title lang="de">Stark</title>
                        <title lang="ru">Сильный</title>
                        <title lang="es">Fuerte</title>
                        <title lang="fr">Fort</title>
                    </meta>
                </param>
            </param>
