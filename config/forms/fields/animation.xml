    <property name="item_animation" type="checkbox" colspan="6" mandatory="false" visibleCondition="animation &amp;&amp; animation != 'none' &amp;&amp; animation != 'parallax'">
        <meta>
            <title lang="en">Animate Items</title>
            <title lang="tr">Alt Öğeleri Animasyonla Göster</title>
            <title lang="de">Elemente einzeln animieren</title>
            <title lang="ru">Анимировать элементы по очереди</title>
            <title lang="es">Animar Elementos Individualmente</title>
            <title lang="fr">Animer les éléments individuellement</title>
            <info_text lang="en">Animate all items sequentially instead of the whole element at once.</info_text>
            <info_text lang="tr">Tüm öğeyi tek seferde değil, alt öğeleri sırayla animasyonla gösterin.</info_text>
            <info_text lang="de">Alle Unterelemente nacheinander statt des gesamten Elements auf einmal animieren.</info_text>
            <info_text lang="ru">Анимировать все элементы последовательно, а не весь блок сразу.</info_text>
            <info_text lang="es">Anime todos los elementos secuencialmente en lugar de todo el bloque a la vez.</info_text>
            <info_text lang="fr">Animez tous les éléments séquentiellement plutôt que l'élément entier d'un coup.</info_text>
        </meta>
        <params>
            <param name="type" value="toggler"/>
            <param name="default_value" value="false"/>
            <param name="label">
                <meta>
                    <title lang="en">Animate items</title>
                    <title lang="tr">Alt öğeleri sırayla canlandır</title>
                    <title lang="de">Elemente animieren</title>
                    <title lang="ru">Анимировать элементы</title>
                    <title lang="es">Animar elementos</title>
                    <title lang="fr">Animer les éléments</title>
                </meta>
            </param>
        </params>
    </property>

    <property name="parallax" type="single_select" colspan="6" mandatory="false" visibleCondition="animation == 'parallax'">
        <meta>
            <title lang="en">Parallax Intensity</title>
            <title lang="tr">Paralaks Yoğunluğu</title>
            <title lang="de">Parallax-Intensität</title>
            <title lang="ru">Интенсивность параллакса</title>
            <title lang="es">Intensidad de Parallax</title>
            <title lang="fr">Intensité de Parallaxe</title>
            <info_text lang="en">Select the parallax motion intensity when scrolling.</info_text>
            <info_text lang="tr">Sayfa kaydırılırken uygulanacak paralaks hareket yoğunluğunu seçin.</info_text>
            <info_text lang="de">Wählen Sie die Intensität der Parallax-Bewegung beim Scrollen.</info_text>
            <info_text lang="ru">Выберите интенсивность эффекта параллакса при прокрутке.</info_text>
            <info_text lang="es">Seleccione la intensidad del movimiento parallax al desplazar.</info_text>
            <info_text lang="fr">Sélectionnez l'intensité du mouvement parallaxe au défilement.</info_text>
        </meta>
        <params>
            <param name="default_value" value="subtle"/>
            <param name="values" type="collection">
                <param name="subtle">
                    <meta>
                        <title lang="en">Subtle</title>
                        <title lang="tr">Hafif</title>
                        <title lang="de">Dezent</title>
                        <title lang="ru">Слабый</title>
                        <title lang="es">Sutil</title>
                        <title lang="fr">Subtil</title>
                    </meta>
