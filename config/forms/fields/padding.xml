<?xml version="1.0" ?>
<form xmlns="http://schemas.sulu.io/template/template"
      xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:schemaLocation="http://schemas.sulu.io/template/template http://schemas.sulu.io/template/form-1.0.xsd">
    <key>block_suite_field_padding</key>
    <properties>
    <property name="padding" type="single_select" colspan="12" mandatory="false">
        <meta>
            <title lang="en">Padding</title>
            <title lang="tr">İç Boşluk (Padding)</title>
            <title lang="de">Innenabstand (Padding)</title>
            <title lang="ru">Внутренний отступ (Padding)</title>
            <title lang="es">Relleno (Padding)</title>
            <title lang="fr">Espacement Interne (Padding)</title>
            <info_text lang="en">Set the padding.</info_text>
            <info_text lang="tr">İç boşluğu ayarlayın.</info_text>
            <info_text lang="de">Legen Sie den Innenabstand fest.</info_text>
            <info_text lang="ru">Установите внутренний отступ.</info_text>
            <info_text lang="es">Establezca el relleno interno.</info_text>
            <info_text lang="fr">Définissez l'espacement interne.</info_text>
        </meta>
        <params>
            <param name="default_value" value=""/>
            <param name="values" type="collection">
                <param name="">
                    <meta>
                        <title lang="en">Keep existing</title>
                        <title lang="tr">Mevcut olanı koru</title>
                        <title lang="de">Bestehenden beibehalten</title>
                        <title lang="ru">Оставить текущий</title>
                        <title lang="es">Mantener existente</title>
                        <title lang="fr">Conserver l'existant</title>
                    </meta>
                </param>
                <param name="xs">
                    <meta>
                        <title lang="en">X-Small</title>
                        <title lang="tr">Çok Küçük (XS)</title>
                        <title lang="de">Extra Klein (XS)</title>
                        <title lang="ru">Очень малый (XS)</title>
                        <title lang="es">Extra Pequeño (XS)</title>
                        <title lang="fr">Très Petit (XS)</title>
                    </meta>
                </param>
                <param name="sm">
                    <meta>
                        <title lang="en">Small</title>
                        <title lang="tr">Küçük (SM)</title>
                        <title lang="de">Klein (SM)</title>
                        <title lang="ru">Малый (SM)</title>
                        <title lang="es">Pequeño (SM)</title>
                        <title lang="fr">Petit (SM)</title>
                    </meta>
                </param>
                <param name="default">
                    <meta>
                        <title lang="en">Default</title>
                        <title lang="tr">Varsayılan</title>
                        <title lang="de">Standard</title>
                        <title lang="ru">По умолчанию</title>
                        <title lang="es">Predeterminado</title>
                        <title lang="fr">Par Défaut</title>
                    </meta>
                </param>
                <param name="md">
                    <meta>
                        <title lang="en">Medium</title>
                        <title lang="tr">Orta (MD)</title>
                        <title lang="de">Mittel (MD)</title>
                        <title lang="ru">Средний (MD)</title>
                        <title lang="es">Mediano (MD)</title>
                        <title lang="fr">Moyen (MD)</title>
                    </meta>
                </param>
                <param name="lg">
                    <meta>
                        <title lang="en">Large</title>
                        <title lang="tr">Büyük (LG)</title>
                        <title lang="de">Groß (LG)</title>
                        <title lang="ru">Большой (LG)</title>
                        <title lang="es">Grande (LG)</title>
                        <title lang="fr">Grand (LG)</title>
                    </meta>
                </param>
                <param name="xl">
                    <meta>
                        <title lang="en">X-Large</title>
                        <title lang="tr">Çok Büyük (XL)</title>
                        <title lang="de">Extra Groß (XL)</title>
                        <title lang="ru">Очень большой (XL)</title>
                        <title lang="es">Extra Grande (XL)</title>
                        <title lang="fr">Très Grand (XL)</title>
                    </meta>
                </param>
                <param name="none">
                    <meta>
                        <title lang="en">None</title>
                        <title lang="tr">Yok</title>
                        <title lang="de">Keine</title>
                        <title lang="ru">Нет</title>
                        <title lang="es">Ninguno</title>
                        <title lang="fr">Aucun</title>
                    </meta>
                </param>
            </param>
        </params>
    </property>

    <property name="padding_remove_top" type="checkbox" colspan="6" mandatory="false" visibleCondition="padding &amp;&amp; padding != 'none' &amp;&amp; padding != 'remove'">
        <meta>
            <title lang="en">Remove Top Padding</title>
            <title lang="tr">Üst İç Boşluğu Kaldır</title>
            <title lang="de">Oberen Innenabstand entfernen</title>
            <title lang="ru">Убрать верхний внутренний отступ</title>
            <title lang="es">Eliminar relleno superior</title>
            <title lang="fr">Supprimer l'espacement interne supérieur</title>
        </meta>
        <params>
            <param name="type" value="toggler"/>
            <param name="default_value" value="false"/>
            <param name="label">
                <meta>
                    <title lang="en">Remove top padding</title>
                    <title lang="tr">Üst iç boşluğu kaldır</title>
                    <title lang="de">Oberen Innenabstand entfernen</title>
                    <title lang="ru">Убрать верхний внутренний отступ</title>
                    <title lang="es">Eliminar relleno superior</title>
                    <title lang="fr">Supprimer le padding haut</title>
                </meta>
            </param>
        </params>
    </property>

    <property name="padding_remove_bottom" type="checkbox" colspan="6" mandatory="false" visibleCondition="padding &amp;&amp; padding != 'none' &amp;&amp; padding != 'remove'">
        <meta>
            <title lang="en">Remove Bottom Padding</title>
            <title lang="tr">Alt İç Boşluğu Kaldır</title>
            <title lang="de">Unteren Innenabstand entfernen</title>
            <title lang="ru">Убрать нижний внутренний отступ</title>
            <title lang="es">Eliminar relleno inferior</title>
            <title lang="fr">Supprimer l'espacement interne inférieur</title>
        </meta>
        <params>
            <param name="type" value="toggler"/>
            <param name="default_value" value="false"/>
            <param name="label">
                <meta>
                    <title lang="en">Remove bottom padding</title>
                    <title lang="tr">Alt iç boşluğu kaldır</title>
                    <title lang="de">Unteren Innenabstand entfernen</title>
                    <title lang="ru">Убрать нижний внутренний отступ</title>
                    <title lang="es">Eliminar relleno inferior</title>
                    <title lang="fr">Supprimer le padding bas</title>
                </meta>
            </param>
        </params>
    </property>
    </properties>
</form>
