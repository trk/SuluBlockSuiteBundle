{
    "name": "trk/sulu-block-suite-bundle",
    "version": "0.2.2",
    "description": "Component block props, visual presets, reusable global blocks, and template layout engine for Sulu CMS",
    "type": "symfony-bundle",
    "license": "MIT",
    "homepage": "https://github.com/trk/SuluBlockSuiteBundle",
    "keywords": [
        "sulu",
        "sulu-bundle",
        "blocks",
        "presets",
        "reusable-blocks",
        "layout",
        "components"
    ],
    "authors": [
        {
            "name": "Iskender TOTOGLU",
            "homepage": "https://github.com/trk"
        }
    ],
    "support": {
        "issues": "https://github.com/trk/SuluBlockSuiteBundle/issues",
        "source": "https://github.com/trk/SuluBlockSuiteBundle"
    },
    "require": {
        "php": ">=8.3",
        "doctrine/orm": "^3.0",
        "psr/log": "^3.0",
        "sulu/sulu": "^3.0",
        "symfony/config": "^7.0",
        "symfony/console": "^7.0",
        "symfony/dependency-injection": "^7.0",
        "symfony/event-dispatcher": "^7.4",
        "symfony/form": "^7.0",
        "symfony/framework-bundle": "^7.0",
        "symfony/http-foundation": "^7.0",
        "symfony/http-kernel": "^7.0",
        "symfony/messenger": "^7.0",
        "symfony/routing": "^7.0",
        "symfony/security-core": "^7.4",
        "symfony/service-contracts": "^3.5",
        "symfony/translation-contracts": "^3.0",
        "symfony/ux-twig-component": "^2.13 || ^3.0",
        "symfony/yaml": "^7.0",
        "twig/twig": "^3.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.0",
        "mcp/sdk": "^0.8.1",
        "phpstan/extension-installer": "^1.3",
        "phpstan/phpstan": "^2.0",
        "phpstan/phpstan-phpunit": "^2.0",
        "phpunit/phpunit": "^11.0 || ^12.0",
        "symfony/property-access": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Totoglu\\SuluBlockSuiteBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Totoglu\\SuluBlockSuiteBundle\\Tests\\": "tests/"
        }
    },
    "config": {
        "allow-plugins": {
            "phpstan/extension-installer": true,
            "php-http/discovery": true
        }
    },
    "extra": {
        "symfony": {
            "allow-contrib": false,
            "require": "7.4.*"
        },
        "ai-mate": {
            "scan-dirs": [
                "src/Mcp"
            ],
            "instructions": "INSTRUCTIONS.md"
        }
    },
    "suggest": {
        "sulu/mcp-bundle": "Enables Sulu Block Suite MCP tools (sulu_block_suite_blocks, sulu_block_suite_presets, sulu_block_suite_compose_block) for AI content management",
        "sulu/sulu-mate-extension": "Enables Symfony AI Mate auto-discovery of Block Suite instructions and MCP tools",
        "trk/sulu-multi-webspace-bundle": "Enables multi-webspace permission filtering and content override integration for Page Layouts, Reusable Blocks, and Block Presets"
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "phpstan": "vendor/bin/phpstan analyse --configuration=phpstan.neon.dist",
        "cs-check": "vendor/bin/php-cs-fixer fix --dry-run --diff",
        "cs-fix": "vendor/bin/php-cs-fixer fix"
    }
}
