{% set snippet = block.snippet|default(null) %}
{% if snippet is not null and snippet is not iterable %}
    {% set snippet = reusable_block_load(snippet) %}
{% elseif snippet is iterable and snippet.blocks is not defined and snippet.content.blocks is not defined %}
    {% set snippet_id = snippet.id|default(snippet.uuid|default(null)) %}
    {% if snippet_id %}
        {% set snippet = reusable_block_load(snippet_id) %}
    {% endif %}
{% endif %}
{% set inner_blocks = block.blocks|default(snippet.blocks|default(snippet.content.blocks|default([]))) %}

{% if inner_blocks is not empty %}
    {% if _nested_block|default(false) %}
        {% for inner_block in inner_blocks|hydrate_blocks(_context) %}
            {% if inner_block.type is defined and inner_block.type != 'reusable' %}
                {{ block_render(inner_block, _context) }}
            {% endif %}
        {% endfor %}
    {% else %}
        {{ blocks_render(inner_blocks, _context) }}
    {% endif %}
{% endif %}
