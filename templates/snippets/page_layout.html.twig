{% set layout_blocks = content.blocks|default([])|hydrate_blocks(_context) %}

{% if layout_blocks is iterable %}
    {% for block in layout_blocks %}
        {% if block.type is defined %}
            {{ sulu_block_render(block, _context|merge({
                page: page|default(null),
                resource: resource|default(_context.resource|default(null)),
                object: object|default(_context.object|default(null)),
                view: view|default(_context.view|default(null)),
                extension: extension|default(_context.extension|default(null)),
                loop: loop,
            })) }}
        {% endif %}
    {% endfor %}
{% endif %}

{% if page_blocks|default([])|length > 0 %}
    {{ sulu_blocks_render(page_blocks, _context|merge({
        content: page|default(_context.content|default([])),
        resource: resource|default(_context.resource|default(null)),
        object: object|default(_context.object|default(null)),
        view: view|default(_context.view|default(null)),
        extension: extension|default(_context.extension|default(null)),
    })) }}
{% endif %}
