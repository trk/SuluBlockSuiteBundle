{% extends 'base.html.twig' %}

{% block content %}
    {% if _is_page_layout_preview|default(false) %}
        {{ layout_render(layout|default(content.layout|default(null)), _context) }}
        {% if content.blocks|default([]) is iterable and content.blocks|default([]) is not empty %}
            {{ blocks_render(content.blocks, _context|merge({_in_page_layout: true})) }}
        {% endif %}
    {% else %}
        {{ blocks_render(content.blocks|default([]), _context) }}
    {% endif %}
{% endblock %}
